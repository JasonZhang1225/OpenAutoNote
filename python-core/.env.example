# Copy this file to python-core/.env (gitignored) or export the variables.
# Never commit a real key.

DASHSCOPE_API_KEY=sk-your-key-here

# beijing (default) -> https://dashscope.aliyuncs.com/api/v1
# intl             -> https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_REGION=beijing

# Optional full override:
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# qwen3-asr-flash-filetrans | qwen3-asr-flash | qwen3-asr-local | faster-whisper
OPENAUTONOTE_STT_BACKEND=qwen3-asr-flash-filetrans
